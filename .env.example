# Copie este arquivo para ".env" e preencha com sua chave da Anthropic.
ANTHROPIC_API_KEY=sk-ant-...

# Porta opcional do servidor Express (padrão: 3000)
PORT=3000

# Voz humanizada via edge-tts — usa as vozes Neural da Microsoft de graça, sem chave
# de API nem conta (precisa de internet). Sem ele instalado (ver README, seção "Voz"),
# o Bambolino cai automaticamente para a síntese de voz nativa do navegador.
# Opcional — o padrão já aponta para o venv instalado dentro do projeto.
EDGE_TTS_BIN_PATH=

# Opcional — nome da voz (padrão: pt-BR-AntonioNeural). Rode
# ".venv/bin/edge-tts --list-voices | grep pt-BR" para ver as outras opções.
EDGE_TTS_VOICE=pt-BR-AntonioNeural
